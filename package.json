{
  "name": "xueleai",
  "version": "0.0.16",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev/start.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @xueleai/database build && pnpm -r typecheck",
    "test": "pnpm --filter @xueleai/database build && pnpm -r test",
    "db:generate": "pnpm --filter @xueleai/database db:generate",
    "db:migrate": "pnpm --filter @xueleai/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @xueleai/database db:migrate:deploy",
    "db:seed": "pnpm --filter @xueleai/database db:seed",
    "textbooks:import-smartedu": "pnpm --filter @xueleai/database textbooks:import-smartedu",
    "textbooks:upload-smartedu-pdfs": "pnpm --filter @xueleai/database textbooks:upload-smartedu-pdfs",
    "textbooks:generate-pdf-covers": "pnpm --filter @xueleai/database textbooks:generate-pdf-covers",
    "textbooks:backup-pdfs": "pnpm --filter @xueleai/database textbooks:backup-pdfs",
    "textbooks:convert-markdown": "pnpm --filter @xueleai/database textbooks:convert-markdown",
    "dict:import-ecdict": "pnpm --filter @xueleai/database dict:import-ecdict",
    "typing:import-yl-7a": "pnpm --filter @xueleai/database typing:import-yl-7a",
    "typing:import-yilin-secondary": "pnpm --filter @xueleai/database typing:import-yilin-secondary",
    "typing:import-yilin-senior": "pnpm --filter @xueleai/database typing:import-yilin-senior",
    "typing:import-hujiao": "pnpm --filter @xueleai/database typing:import-hujiao",
    "typing:import-pep": "pnpm --filter @xueleai/database typing:import-pep",
    "typing:import-cet": "pnpm --filter @xueleai/database typing:import-cet",
    "typing:sync-cet-dictionary": "pnpm --filter @xueleai/database typing:sync-cet-dictionary",
    "typing:sync-content-snapshot": "pnpm --filter @xueleai/database typing:sync-content-snapshot",
    "typing:migrate-images-r2": "pnpm --filter @xueleai/database typing:migrate-images-r2",
    "typing:sync-scenario": "pnpm --filter @xueleai/database typing:sync-scenario",
    "typing:media-manifest": "pnpm --filter @xueleai/database exec node --env-file=\"$INIT_CWD/.env\" --import tsx ../../scripts/typing/typing-media-manifest.ts",
    "typing:register-media": "pnpm --filter @xueleai/database exec node --env-file=\"$INIT_CWD/.env\" --import tsx ../../scripts/typing/register-typing-media.ts",
    "typing:generate-audio": "pnpm --filter @xueleai/database exec node --env-file=\"$INIT_CWD/.env\" --import tsx ../../scripts/typing/generate-typing-audio.ts",
    "typing:process-images": "pnpm --filter @xueleai/database exec tsx ../../scripts/typing/process-generated-unit1-images.ts",
    "seed:demo": "DATABASE_URL=\"${DATABASE_URL:-postgresql://xueleai:xueleai_dev_password@localhost:3324/xueleai?schema=public}\" pnpm --filter @xueleai/database seed:demo",
    "template:blank": "DATABASE_URL=\"${DATABASE_URL:-postgresql://xueleai:xueleai_dev_password@localhost:3324/xueleai?schema=public}\" pnpm --filter @xueleai/database template:blank",
    "ai:seed-tools": "pnpm --filter @xueleai/database ai:seed-tools",
    "ai:seed-presets": "pnpm --filter @xueleai/database ai:seed-presets",
    "ai:sync-scenarios": "pnpm --filter @xueleai/api-core ai:sync-scenarios",
    "audio:enrich-voices": "pnpm --filter @xueleai/database exec tsx ../../scripts/audio/enrich-voice-library.ts",
    "audio:enrich-voices:apply": "pnpm --filter @xueleai/database exec tsx ../../scripts/audio/enrich-voice-library.ts --apply",
    "audio:prepare-avatar-prompts": "pnpm --filter @xueleai/database exec tsx ../../scripts/audio/prepare-voice-avatar-prompts.ts",
    "audio:audit-avatars": "pnpm --filter @xueleai/database exec tsx ../../scripts/audio/audit-voice-avatars.ts",
    "release:check": "node scripts/release/check.mjs",
    "release:github-check": "scripts/release/github-publish-check.sh",
    "release:test": "node --test scripts/release/release-pipeline.test.mjs scripts/release/migrate-production-isolation.test.mjs",
    "release:publish": "scripts/release/publish.sh",
    "release:deploy": "scripts/release/deploy.sh",
    "release:server": "scripts/release/server-release.sh",
    "release:migrate-production-isolation": "scripts/release/migrate-production-isolation.sh",
    "release:verify-live": "node scripts/release/verify-live.mjs"
  },
  "devDependencies": {
    "sharp": "0.34.5"
  }
}
