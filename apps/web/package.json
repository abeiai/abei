    "@mediapipe/tasks-vision": "1.0.1",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "^0.16.47",
    "lucide-react": "1.14.0",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "parse5": "^8.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.5",
