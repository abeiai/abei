# 复制为 .env.production 后再部署。不要提交真实生产密钥。

NODE_ENV="production"
APP_VERSION="0.0.0"
APP_RELEASE_SHA="unknown"
COMPOSE_PROJECT_NAME="xueleai-prod"
POSTGRES_VOLUME_NAME="xueleai-prod_postgres_data"
REDIS_VOLUME_NAME="xueleai-prod_redis_data"
TZ="Asia/Shanghai"

APP_BASE_URL="https://example.com"
API_BASE_URL="http://api-core:3322/api"
AI_GATEWAY_BASE_URL="http://ai-gateway:3323"
API_CORE_PORT="3322"
API_BODY_LIMIT="12mb"

# 线上公网入口使用常用端口；容器内部仍映射到 3320/3326。
NGINX_HTTP_PORT="80"
NGINX_HTTPS_PORT="443"

POSTGRES_USER="xueleai"
POSTGRES_PASSWORD="请替换为高强度数据库密码"
POSTGRES_DB="xueleai"
POSTGRES_BIND_HOST="127.0.0.1"
POSTGRES_HOST_PORT="3327"
DATABASE_URL="postgresql://xueleai:请替换为高强度数据库密码@postgres:3327/xueleai?schema=public"
REDIS_URL="redis://redis:3328"

JWT_ACCESS_SECRET="请替换为至少32位随机字符串"
JWT_REFRESH_SECRET="请替换为至少32位随机字符串"
PROFILE_CONTEXT_SECRET="请替换为至少32位随机字符串"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="400d"
SECRET_ENCRYPTION_KEY="请替换为至少32位随机字符串"
STUDENT_PHOTO_STORAGE_SECRET="请替换为固定的高强度随机字符串"

RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_AUTH_LOGIN_MAX="10"
RATE_LIMIT_AUTH_REGISTER_MAX="5"
RATE_LIMIT_AUTH_EMAIL_CODE_MAX="5"
RATE_LIMIT_AUTH_EMAIL_CODE_SUBJECT_MAX="3"
RATE_LIMIT_AUTH_RESET_PASSWORD_MAX="5"
RATE_LIMIT_AUTH_RESET_PASSWORD_SUBJECT_MAX="5"
