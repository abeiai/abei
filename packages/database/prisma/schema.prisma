  session               TypingPracticeSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item                  EnglishContentItem              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  repeatOf              TypingPracticeSessionItem?      @relation("TypingSessionItemRepeats", fields: [repeatOfSessionItemId], references: [id], onDelete: SetNull)
  repeats               TypingPracticeSessionItem[]     @relation("TypingSessionItemRepeats")
  attempts              TypingAttempt[]

  @@unique([sessionId, queueOrder])
  @@index([itemId])
  @@index([repeatOfSessionItemId])
  @@index([sessionId, status])
  @@map("typing_practice_session_items")
}

model TypingAttempt {
  id               String                    @id @default(cuid())
  sessionId        String
  sessionItemId    String
  itemId           String
  itemVersion      String
  clientAttemptId  String                    @unique
  attemptNumber    Int
  isCorrect        Boolean
  errorTypes       TypingErrorType[]
  errorPositions   Json
  durationMs       Int
  hintLevel        Int                       @default(0)
  audioReplayCount Int                       @default(0)
  isReview         Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  session          TypingPracticeSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionItem      TypingPracticeSessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Cascade)
  item             EnglishContentItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([sessionItemId, attemptNumber])
  @@index([sessionId, createdAt])
  @@index([itemId, createdAt])
  @@map("typing_attempts")
}

model TypingReviewState {
  id             String                  @id @default(cuid())
  subjectKey     String
  userId         String
  learnerId      String?
  itemId         String
  itemVersion    String
  state          TypingReviewStateStatus @default(NEW)
  stage          Int                     @default(0)
  dueAt          DateTime?
  lastReviewedAt DateTime?
  masteredAt     DateTime?
  totalAttempts  Int                     @default(0)
  totalCorrect   Int                     @default(0)
  lapseCount     Int                     @default(0)
  hintCount      Int                     @default(0)
  correctStreak  Int                     @default(0)
  algorithmVersion String                @default("typing-stages-v1")
  difficulty     Float?
  stability      Float?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  learner        Learner?                @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  item           EnglishContentItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([subjectKey, itemId])
  @@index([subjectKey, dueAt, stage])
  @@index([itemId])
  @@index([userId, learnerId])
  @@map("typing_review_states")
}

model TypingPreference {
  id                   String           @id @default(cuid())
  subjectKey           String           @unique
  userId               String
  learnerId            String?          @unique
  accent               TypingAccent     @default(UK)
  autoPlayAudio        Boolean          @default(true)
  replayAfterCorrect   Boolean          @default(true)
  showImage            Boolean          @default(true)
  feedbackSoundEnabled Boolean          @default(true)
  soundVolume          Float            @default(0.8)
  inputStyle           TypingInputStyle @default(UNDERLINE)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  learner              Learner?         @relation(fields: [learnerId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("typing_preferences")
}

model MembershipPlan {
  periods MembershipPeriod[]
  id String @id @default(cuid())
  name String
  rank Int
  isEnabled Boolean @default(true)
  storageGb Int @default(0)
  learnerLimit Int @default(1)
  benefits Json
  prices Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isEnabled, rank])
  @@map("membership_plans")
}
model MembershipPeriod {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  allocations MembershipCreditAllocation[]
  id String @id @default(cuid())
  userId String
  planId String
  orderId String @unique
  name String
  rank Int
  storageGb Int
  learnerLimit Int
  benefits Json
  credits Int
  remainingCredits Int
  startsAt DateTime
  endsAt DateTime
  grantedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, startsAt, endsAt])
  @@map("membership_periods")
}
model MembershipCreditAllocation {
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  period MembershipPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  id String @id @default(cuid())
  operationKey String @unique
  userId String
  periodId String?
  membershipCredits Int
  purchasedCredits Int
  settled Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("membership_credit_allocations")
}
