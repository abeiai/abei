model OrganizationSettings {
  orgId                String       @id
  defaultMemberRole    OrganizationMemberRole @default(MEMBER)
  defaultQuota         Int          @default(0)
  quotaResetDay        Int          @default(1)
  lowBalanceThreshold  Int          @default(1000)
  usageAlertEnabled    Boolean      @default(true)
  invoiceRequired      Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OrganizationMember {
  id            String                   @id @default(cuid())
  orgId         String
  userId        String
  role          OrganizationMemberRole   @default(MEMBER)
  status        OrganizationMemberStatus @default(ACTIVE)
  title         String?
  joinedAt      DateTime                 @default(now())
  invitedById   String?
  removedAt     DateTime?
  removedById   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  organization  Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotas        OrganizationMemberQuota[]
  quotaLedgers  OrganizationQuotaLedger[]
  usageEvents   OrganizationUsageEvent[]
  reservations  OrganizationWalletReservation[]
  aiTasks       AiTask[]
  audioTasks    AudioTask[]

  @@unique([orgId, userId])
  @@index([userId])
  @@index([role])
  @@index([status])
  @@map("organization_members")
}

model OrganizationWallet {
  id               String                   @id @default(cuid())
  orgId            String                   @unique
  status           OrganizationWalletStatus @default(ACTIVE)
  balanceTotal     Int                      @default(0)
  balanceAvailable Int                      @default(0)
  balanceReserved  Int                      @default(0)
  totalPurchased   Int                      @default(0)
  totalGranted     Int                      @default(0)
  totalConsumed    Int                      @default(0)
  totalExpired     Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  organization     Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pointLots        OrganizationPointLot[]
  ledgers          OrganizationWalletLedger[]
  reservations     OrganizationWalletReservation[]

  @@index([status])
  @@map("organization_wallets")
}

model OrganizationPointLot {
  id              String                     @id @default(cuid())
  walletId        String
  orgId           String
  sourceType      String
  sourceId        String?
  initialPoints   Int
  remainingPoints Int
  effectiveAt     DateTime                   @default(now())
  expiresAt       DateTime?
  status          OrganizationPointLotStatus  @default(ACTIVE)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  wallet          OrganizationWallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  organization    Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledgers         OrganizationWalletLedger[]

  @@index([walletId])
  @@index([orgId])
  @@index([status, expiresAt])
  @@map("organization_point_lots")
}

model OrganizationWalletLedger {
  id              String                            @id @default(cuid())
  orgId           String
  walletId        String
  lotId           String?
  direction       OrganizationWalletLedgerDirection
  transactionType OrganizationWalletTransactionType
  pointsDelta     Int
  balanceAfter    Int
  sourceType      String?
  sourceId        String?
  idempotencyKey  String                            @unique
  operatorType    String                            @default("system")
  operatorId      String?
  remark          String?
  createdAt       DateTime                          @default(now())
  organization    Organization                      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wallet          OrganizationWallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  lot             OrganizationPointLot?             @relation(fields: [lotId], references: [id], onDelete: SetNull)
  usageEvents     OrganizationUsageEvent[]

  @@index([orgId, createdAt])
  @@index([walletId])
  @@index([lotId])
  @@index([transactionType])
  @@map("organization_wallet_ledgers")
}

model OrganizationWalletReservation {
  id              String                    @id @default(cuid())
  orgId           String
  walletId        String
  memberId        String
  usageRequestId  String                    @unique
  reservedPoints  Int
  settledPoints   Int                       @default(0)
  status          OrganizationReservationStatus @default(RESERVED)
  expiresAt       DateTime
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  settledAt       DateTime?
  organization    Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wallet          OrganizationWallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  member          OrganizationMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  usageEvents     OrganizationUsageEvent[]

  @@index([orgId])
  @@index([memberId])
  @@index([status])
  @@index([expiresAt])
  @@map("organization_wallet_reservations")
}

model EnterpriseOrder {
  id              String        @id @default(cuid())
  orderNo         String        @unique
  orgId           String
  buyerMemberId   String?
  packageId       String?
  pointsAmount    Int
  bonusPoints     Int           @default(0)
  cashAmount      Decimal       @db.Decimal(10, 2)
  originalAmount  Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  currency        String        @default("CNY")
  status          String        @default("pending_payment")
  paymentMethod   String?
  paymentTransactionId String?
  invoiceStatus   String        @default("not_required")
  paidAt          DateTime?
  creditedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
  @@map("enterprise_orders")
}

model OrganizationMemberQuota {
  id              String                  @id @default(cuid())
  orgId           String
  memberId        String
  quotaType       OrganizationQuotaType   @default(ONE_TIME)
  periodStart     DateTime?
  periodEnd       DateTime?
  totalQuota      Int
  usedQuota       Int                     @default(0)
  reservedQuota   Int                     @default(0)
  status          OrganizationQuotaStatus @default(ACTIVE)
  createdById     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member          OrganizationMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  quotaLedgers    OrganizationQuotaLedger[]
  usageEvents     OrganizationUsageEvent[]

  @@index([orgId])
  @@index([memberId])
  @@index([status])
  @@map("organization_member_quotas")
}

model OrganizationQuotaLedger {
  id              String                           @id @default(cuid())
  orgId           String
  memberId        String
  quotaAccountId  String
  direction       OrganizationQuotaLedgerDirection
  pointsDelta     Int
  quotaAfter      Int
  sourceType      String?
  sourceId        String?
  operatorId      String?
  idempotencyKey  String                           @unique
  remark          String?
  createdAt       DateTime                         @default(now())
  organization    Organization                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member          OrganizationMember               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  quotaAccount    OrganizationMemberQuota          @relation(fields: [quotaAccountId], references: [id], onDelete: Cascade)
  usageEvents     OrganizationUsageEvent[]

  @@index([orgId, createdAt])
  @@index([memberId])
  @@index([quotaAccountId])
  @@map("organization_quota_ledgers")
}

model OrganizationUsageEvent {
  id              String                       @id @default(cuid())
  orgId           String
  userId          String
  memberId        String
  quotaAccountId  String?
  featureCode     String
  resourceType    String?
  resourceId      String?
  usageQuantity   Decimal                      @default(0) @db.Decimal(14, 4)
  usageUnit        String?
  unitPrice        Decimal                      @default(0) @db.Decimal(14, 6)
  pointsCharged    Int
  pricingVersion   String?
  walletLedgerId   String?
  quotaLedgerId    String?
  reservationId    String?
  status           OrganizationUsageEventStatus @default(SUCCESS)
  idempotencyKey   String                       @unique
  occurredAt       DateTime                     @default(now())
  createdAt        DateTime                     @default(now())
  organization     Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  member           OrganizationMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  quotaAccount     OrganizationMemberQuota?     @relation(fields: [quotaAccountId], references: [id], onDelete: SetNull)
  walletLedger     OrganizationWalletLedger?    @relation(fields: [walletLedgerId], references: [id], onDelete: SetNull)
  quotaLedger      OrganizationQuotaLedger?     @relation(fields: [quotaLedgerId], references: [id], onDelete: SetNull)
  reservation      OrganizationWalletReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([orgId, occurredAt])
  @@index([userId, occurredAt])
  @@index([memberId, occurredAt])
  @@index([featureCode])
  @@index([resourceType, resourceId])
  @@map("organization_usage_events")
}

model AiTask {
  id               String       @id @default(cuid())
  userId           String
  learnerId        String?
  billingContext   BillingContextType @default(PERSONAL)
  organizationId   String?
  organizationMemberId String?
  scenarioId       String
  knowledgeBaseId  String?
  aiProviderId     String?
  aiModelId        String?
  aiProviderInstanceId String?
  aiModelInstanceId    String?
  status           AiTaskStatus @default(CREATED)
  input            Json
  renderedPrompt   String?
  output           String?
  inputPreview     String?
  outputPreview    String?
  inputHash        String?
  outputHash       String?
  saveFullContent  Boolean      @default(false)
  errorMessage     String?
  estimatedCredits Int
  actualCredits    Int?
  providerName     String?
  modelName        String?
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  finishedAt       DateTime?
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learner          Learner?     @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationMember OrganizationMember? @relation(fields: [organizationMemberId], references: [id], onDelete: SetNull)
  scenario         AiScenario   @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  knowledgeBase    KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  aiProvider       AiProvider?  @relation(fields: [aiProviderId], references: [id], onDelete: SetNull)
  aiModel          AiModel?     @relation(fields: [aiModelId], references: [id], onDelete: SetNull)
  aiProviderInstance AiProviderInstance? @relation(fields: [aiProviderInstanceId], references: [id], onDelete: SetNull)
  aiModelInstance    AiModelInstance?    @relation(fields: [aiModelInstanceId], references: [id], onDelete: SetNull)
  reservation      CreditReservation?
  ledgerEntries    LedgerEntry[]
  callLogs         AiCallLog[]
  learningFlashcardDecks LearningFlashcardDeck[]

  @@index([userId, createdAt])
  @@index([userId, learnerId, createdAt])
  @@index([learnerId])
  @@index([billingContext])
  @@index([organizationId])
  @@index([organizationMemberId])
  @@index([scenarioId])
  @@index([knowledgeBaseId])
  @@index([aiProviderId])
  @@index([aiModelId])
  @@index([aiProviderInstanceId])
  @@index([aiModelInstanceId])
  @@index([status])
  @@map("ai_tasks")
}

model AiUsageDailyStat {
  id                 String    @id @default(cuid())
  date               DateTime  @db.Date
  dimensionKey       String    @unique
  providerId         String?
  modelId            String?
  providerInstanceId String?
  modelInstanceId    String?
  scenarioId         String?
  toolId             String?
  userId             String?
  providerName       String?
  modelName          String?
  scenarioName       String?
  toolName           String?
  userEmail          String?
  requestCount       Int       @default(0)
  successCount       Int       @default(0)
  failureCount       Int       @default(0)
  inputTokens        Int       @default(0)
  outputTokens       Int       @default(0)
  totalTokens        Int       @default(0)
  consumedCredits    Int       @default(0)
  estimatedCost      Decimal   @default(0) @db.Decimal(12, 4)
  avgLatencyMs       Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  scenario           AiScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  aiProvider         AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  aiModel            AiModel?    @relation(fields: [modelId], references: [id], onDelete: SetNull)
  providerInstance   AiProviderInstance? @relation(fields: [providerInstanceId], references: [id], onDelete: SetNull)
  modelInstance      AiModelInstance?    @relation(fields: [modelInstanceId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([providerId])
  @@index([modelId])
  @@index([providerInstanceId])
  @@index([modelInstanceId])
  @@index([scenarioId])
  @@index([toolId])
  @@index([userId])
  @@map("ai_usage_daily_stats")
}

model AiCallLog {
  id           String     @id @default(cuid())
  taskId       String
  providerId   String?
  modelId      String?
  providerInstanceId String?
  modelInstanceId    String?
  provider     String
  model        String
  requestId    String?
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  latencyMs    Int?
  success      Boolean    @default(false)
  errorCode    String?
  errorMessage String?
  createdAt    DateTime   @default(now())
  task         AiTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  aiProvider   AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  aiModel      AiModel?    @relation(fields: [modelId], references: [id], onDelete: SetNull)
  providerInstance AiProviderInstance? @relation(fields: [providerInstanceId], references: [id], onDelete: SetNull)
  modelInstance    AiModelInstance?    @relation(fields: [modelInstanceId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([providerId])
  @@index([modelId])
  @@index([providerInstanceId])
  @@index([modelInstanceId])
  @@index([success])
  @@index([createdAt])
  @@map("ai_call_logs")
}

model SystemAlert {
  id                  String     @id @default(cuid())
  type                String
  level               String
  title               String
  message             String
  status              String     @default("OPEN")
  fingerprint         String     @unique
  relatedResourceType String?
  relatedResourceId   String?
  createdAt           DateTime   @default(now())
  resolvedAt          DateTime?
  resolvedByAdminId   String?
  resolver            AdminUser? @relation("ResolvedSystemAlerts", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type])
  @@index([level])
  @@map("system_alerts")
}

model AudioAsset {
  id              String               @id @default(cuid())
  userId          String
  type            AudioAssetType
  storageProvider MediaStorageProvider @default(LOCAL)
  url             String
  objectKey       String
  mimeType        String
  durationMs      Int?
  sizeBytes       Int
  sampleRate      Int?
  channels        Int?
  createdAt       DateTime             @default(now())
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceVoiceAssets VoiceAsset[]       @relation("VoiceSourceAudioAsset")
  previewVoiceAssets VoiceAsset[]      @relation("VoicePreviewAudioAsset")
  sourceAudioTasks AudioTask[]         @relation("AudioTaskSourceAsset")
  outputAudioTasks AudioTask[]         @relation("AudioTaskOutputAsset")
  voiceConsents    VoiceConsent[]

  dialogueOutputs AudioDialogueProject[]

  @@index([userId, createdAt])
  @@index([type])
  @@map("audio_assets")
}

model VoiceAsset {
  id                   String                @id @default(cuid())
  userId               String
  providerInstanceId   String?
  provider             String
  providerVoiceId      String?
  name                 String
  type                 VoiceAssetType
  targetModel          String
  status               VoiceAssetStatus      @default(DRAFT)
  visibility           VoiceAssetVisibility  @default(PRIVATE)
  language             String?
  accent               String?
  gender               String?
  ageCategory          String?
  avatarUrl             String?
  description          String?
  previewAudioUrl      String?
  sourceAudioAssetId   String?
  previewAudioAssetId  String?
  consentId            String?
  isPlatform           Boolean               @default(false)
  reviewedByAdminId    String?
  reviewedAt           DateTime?
  reviewNote           String?
  disabledReason       String?
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerInstance     AiProviderInstance?   @relation(fields: [providerInstanceId], references: [id], onDelete: SetNull)
  sourceAudioAsset     AudioAsset?           @relation("VoiceSourceAudioAsset", fields: [sourceAudioAssetId], references: [id], onDelete: SetNull)
  previewAudioAsset    AudioAsset?           @relation("VoicePreviewAudioAsset", fields: [previewAudioAssetId], references: [id], onDelete: SetNull)
  audioTasks           AudioTask[]
  consent              VoiceConsent?        @relation("VoiceAssetConsent", fields: [consentId], references: [id], onDelete: SetNull)
  targetConsent        VoiceConsent?        @relation("VoiceConsentTarget")
  reviewer             AdminUser?           @relation("ReviewedVoiceAssets", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  defaultForPreferences UserAudioPreference[] @relation("DefaultVoiceAsset")
  audioUsageLogs       AudioUsageLog[]

  @@index([userId, createdAt])
  @@index([providerInstanceId])
  @@index([providerVoiceId])
  @@index([isPlatform, type, status])
  @@index([targetModel])
  @@index([status])
  @@index([consentId])
  @@index([reviewedByAdminId])
  @@map("voice_assets")
}

model VoiceConsent {
  id                 String       @id @default(cuid())
  userId             String
  voiceAssetId       String?      @unique
  sourceAudioAssetId String?
  consentText        String       @default("")
  consentType        VoiceConsentType @default(SELF_VOICE)
  ownerName          String?
  ownerContact       String?
  agreedAt           DateTime     @default(now())
  statement          String
  ip                 String?
  userAgent          String?
  createdAt          DateTime     @default(now())
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceAsset         VoiceAsset?  @relation("VoiceConsentTarget", fields: [voiceAssetId], references: [id], onDelete: SetNull)
  sourceAudioAsset   AudioAsset?  @relation(fields: [sourceAudioAssetId], references: [id], onDelete: SetNull)
  voiceAssets        VoiceAsset[] @relation("VoiceAssetConsent")

  @@index([userId, createdAt])
  @@index([voiceAssetId])
  @@index([sourceAudioAssetId])
  @@map("voice_consents")
}

model UserAudioPreference {
  id                    String      @id @default(cuid())
  userId                String      @unique
  defaultVoiceAssetId   String?
  defaultSystemVoiceId  String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultVoiceAsset     VoiceAsset? @relation("DefaultVoiceAsset", fields: [defaultVoiceAssetId], references: [id], onDelete: SetNull)

  @@index([defaultVoiceAssetId])
  @@map("user_audio_preferences")
}

model AudioPricingRule {
  id              String           @id @default(cuid())
  operationType   AudioTaskType
  model           String           @default("*")
  billingMode     AudioBillingMode
  creditsPerUnit  Decimal          @db.Decimal(10, 4)
  minimumCredits  Int              @default(0)
  modelMultiplier Decimal          @default(1) @db.Decimal(8, 4)
  isEnabled       Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([operationType, model])
  @@index([operationType, isEnabled])
  @@index([model])
  @@map("audio_pricing_rules")
}

model AudioTask {
  id                   String              @id @default(cuid())
  userId               String
  learnerId            String?
  scenarioId           String?
  billingContext       BillingContextType  @default(PERSONAL)
  organizationId       String?
  organizationMemberId String?
  type                 AudioTaskType
  status               AudioTaskStatus     @default(CREATED)
  provider             String
  model                String
  providerInstanceId   String?
  modelInstanceId      String?
  voiceAssetId         String?
  inputText            String?
  inputTextLength      Int                 @default(0)
  sourceAudioAssetId   String?
  outputAudioAssetId   String?
  estimatedCredits     Int
  actualCredits        Int?
  errorCode            String?
  errorMessage         String?
  requestId            String?
  providerPayload      Json?
  audioDialogueGenerationId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  finishedAt           DateTime?
  englishGuidedStudyMaterials EnglishGuidedStudyMaterial[]
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  learner              Learner?            @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  scenario             AiScenario?         @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  organization         Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationMember   OrganizationMember? @relation(fields: [organizationMemberId], references: [id], onDelete: SetNull)
  providerInstance     AiProviderInstance? @relation(fields: [providerInstanceId], references: [id], onDelete: SetNull)
  modelInstance        AiModelInstance?    @relation(fields: [modelInstanceId], references: [id], onDelete: SetNull)
  voiceAsset           VoiceAsset?         @relation(fields: [voiceAssetId], references: [id], onDelete: SetNull)
  sourceAudioAsset     AudioAsset?         @relation("AudioTaskSourceAsset", fields: [sourceAudioAssetId], references: [id], onDelete: SetNull)
  outputAudioAsset     AudioAsset?         @relation("AudioTaskOutputAsset", fields: [outputAudioAssetId], references: [id], onDelete: SetNull)
  reservation          CreditReservation?
  ledgerEntries        LedgerEntry[]
  usageLogs            AudioUsageLog[]
  audioDialogueGeneration AudioDialogueGeneration? @relation("DialogueSegmentTasks", fields: [audioDialogueGenerationId], references: [id], onDelete: SetNull)
  dialogueBillingGeneration AudioDialogueGeneration? @relation("DialogueBillingTask")

  @@index([userId, createdAt])
  @@index([userId, learnerId, createdAt])
  @@index([learnerId])
  @@index([scenarioId])
  @@index([billingContext])
  @@index([organizationId])
  @@index([organizationMemberId])
  @@index([type])
  @@index([status])
  @@index([providerInstanceId])
  @@index([modelInstanceId])
  @@index([voiceAssetId])
  @@index([sourceAudioAssetId])
  @@index([outputAudioAssetId])
  @@index([audioDialogueGenerationId])
  @@map("audio_tasks")
}

model AudioDialogueProject {
  id String @id @default(cuid())
  userId String
  learnerId String?
  scenarioId String?
  title String
  revision Int @default(1)
  status String @default("DRAFT")
  input Json
  clips Json @default("{}")
  actualCredits Int @default(0)
  outputAudioAssetId String?
  outputRevision Int?
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  outputAudioAsset AudioAsset? @relation(fields: [outputAudioAssetId], references: [id], onDelete: SetNull)
  generations AudioDialogueGeneration[]

  @@index([userId, learnerId, createdAt])
  @@map("audio_dialogue_projects")
}

model AudioDialogueGeneration {
  id String @id @default(cuid())
  projectId String
  revision Int
  status String @default("QUOTED")
  input Json
  plans Json
  fingerprint String
  estimatedCredits Int
  actualCredits Int?
  billingAudioTaskId String? @unique
  leaseOwner String?
  leaseUntil DateTime?
  expiresAt DateTime
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project AudioDialogueProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  billingAudioTask AudioTask? @relation("DialogueBillingTask", fields: [billingAudioTaskId], references: [id], onDelete: SetNull)
  audioTasks AudioTask[] @relation("DialogueSegmentTasks")

  @@index([projectId, createdAt])
  @@index([status, leaseUntil])
  @@map("audio_dialogue_generations")
}

model AudioUsageLog {
  id                 String              @id @default(cuid())
  taskId             String              @unique
  userId             String
  provider           String
  model              String
  providerInstanceId String?
  modelInstanceId    String?
  voiceAssetId       String?
  operationType      AudioTaskType
  characterCount     Int                 @default(0)
  audioDurationMs    Int?
  usageCount         Int                 @default(1)
  latencyMs          Int?
  success            Boolean             @default(false)
  estimatedCost      Decimal             @default(0) @db.Decimal(12, 4)
  consumedCredits    Int                 @default(0)
  providerRequestId  String?
