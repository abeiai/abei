model User {
  referralHandles ReferralHandle[]
  referralVisits ReferralVisit[]
  referralsSent ReferralReward[] @relation("ReferrerRewards")
  referralReceived ReferralReward? @relation("ReferredReward")
  membershipPeriods MembershipPeriod[]
  membershipCreditAllocations MembershipCreditAllocation[]
  id            String         @id @default(cuid())
  accountNumber Int            @unique @default(autoincrement())
  nextLearnerNumber Int        @default(100)
  email         String         @unique
  phone         String?        @unique
  phoneVerifiedAt DateTime?
  wechatOpenId     String?     @unique
  wechatMpOpenId   String?     @unique
  wechatWebOpenId  String?     @unique
  wechatUnionId    String?     @unique
  passwordHash  String
  passwordLoginEnabled Boolean @default(true)
  learnerSwitchPasswordHash String?
  nickname      String
  avatarUrl     String?
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  learners      Learner[]
  learnerActivityEvents LearnerActivityEvent[]
  learnerLearningSessions LearnerLearningSession[]
  learnerLearningTimeSlices LearnerLearningTimeSlice[]
  learnerMaterialProgress LearnerMaterialProgress[]
  learnerDailyLearningSummaries LearnerDailyLearningSummary[]
  wallet        Wallet?
  paymentOrders PaymentOrder[]
  ledgerEntries LedgerEntry[]
  aiTasks       AiTask[]
  reservations  CreditReservation[]
  knowledgeBases KnowledgeBase[]
  aiToolCalls    AiToolCall[]
  aiUsageStats   AiUsageDailyStat[]
  audioAssets     AudioAsset[]
  voiceAssets     VoiceAsset[]
  audioTasks      AudioTask[]
  audioDialogueProjects AudioDialogueProject[]
  voiceConsents   VoiceConsent[]
  audioPreference UserAudioPreference?
  audioUsageLogs  AudioUsageLog[]
  videoGuideLessons           VideoGuideLesson[]
  videoGuideAssetRefs         VideoGuideAssetRef[]
  englishGuidedStudyMaterials EnglishGuidedStudyMaterial[]
  learningFlashcardDecks      LearningFlashcardDeck[]
  learningFlashcardReviews    LearningFlashcardReview[]
  courses                     Course[]
  enrolledCourses             CourseEnrollment[]
  mediaAssets                 MediaAsset[]
  copybookFonts               CopybookFont[]
  copybookRecords             CopybookRecord[]
  submittedCourseReviews      CourseReviewRequest[] @relation("SubmittedCourseReviews")
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  organizationMembers OrganizationMember[]
  organizationUsageEvents OrganizationUsageEvent[]
  typingLibraryProgress TypingLibraryProgress[]
  typingSessions TypingPracticeSession[]
  typingReviewStates TypingReviewState[]
  typingPreferences TypingPreference[]
  pictureBooks PictureBook[]
  pictureBookCharacters PictureBookCharacter[]

  @@map("users")
}

model PictureBook {
  id           String   @id @default(cuid())
  userId       String
  title        String
  brief        String   @db.Text
  theme        String   @default("")
  audience     String   @default("")
  plot         String   @default("") @db.Text
  style        String
  aspectRatio  String   @default("1:1")
  pageCount    Int
  status       String   @default("PLANNING")
  messages     Json
  characters   Json
  pages        Json
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisionItems CourseRevisionItem[]
  materialPublication CourseMaterialPublication?

  @@index([userId, updatedAt])
  @@map("picture_books")
}

model PictureBookCharacter {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @db.Text
  imageUrl    String?
  styleImages Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("picture_book_characters")
}

model ReferralHandle {
  handle String @id
  userId String
  kind String
  status String @default("ACTIVE")
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([status, createdAt])
  @@map("referral_handles")
}

model ReferralVisit {
  tokenHash String @id
  referrerId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  reward ReferralReward?

  @@index([expiresAt])
  @@map("referral_visits")
}

model ReferralReward {
  inviteeId String @id
  referrerId String
  visitHash String @unique
  credits Int @default(500)
  createdAt DateTime @default(now())
  invitee User @relation("ReferredReward", fields: [inviteeId], references: [id], onDelete: Cascade)
  referrer User @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Cascade)
  visit ReferralVisit @relation(fields: [visitHash], references: [tokenHash], onDelete: Restrict)

  @@index([referrerId, createdAt])
  @@map("referral_rewards")
}

model SmsVerificationCode {
  id            String         @id @default(cuid())
  phone         String
  purpose       SmsCodePurpose
  codeHash      String
  expiresAt     DateTime
  consumedAt    DateTime?
  sendProvider  String?
  sendRequestId String?
  sendStatus    String?
  createdAt     DateTime       @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
  @@map("sms_verification_codes")
}

model EmailVerificationCode {
  id            String           @id @default(cuid())
  email         String
  purpose       EmailCodePurpose
  codeHash      String
  expiresAt     DateTime
  consumedAt    DateTime?
  sendProvider  String?
  sendRequestId String?
  sendStatus    String?
  createdAt     DateTime         @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

model AdminUser {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          AdminRole      @default(SUPER_ADMIN)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  operationLogs AdminOperationLog[]
  mediaAssets   MediaAsset[]
  copybookFonts CopybookFont[]
  resolvedAlerts SystemAlert[] @relation("ResolvedSystemAlerts")
  reviewedVoiceAssets VoiceAsset[] @relation("ReviewedVoiceAssets")
  reviewedCourseReviews CourseReviewRequest[] @relation("ReviewedCourseReviews")

  @@map("admin_users")
}

model RefreshToken {
  id          String           @id @default(cuid())
  userId      String?
  adminUserId String?
  tokenHash   String
  type        RefreshTokenType
  profileMode UserProfileMode @default(UNSELECTED)
  profileLearnerId String?
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  revokedAt   DateTime?
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser   AdminUser?       @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  profileLearner Learner?      @relation(fields: [profileLearnerId], references: [id], onDelete: Restrict)
  learnerLearningSessions LearnerLearningSession[]

  @@index([userId])
  @@index([adminUserId])
  @@index([tokenHash])
  @@index([profileLearnerId])
  @@map("refresh_tokens")
}

model Learner {
  id                     String   @id @default(cuid())
  userId                 String
  accountNumber          Int
  nickname               String
  grade                  LearnerGrade
  avatarUrl              String?
  status                 LearnerStatus @default(ACTIVE)
  deactivatedAt          DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  scenarioAuthorizations LearnerScenarioAuthorization[]
  courseAuthorizations   LearnerCourseAuthorization[]
  activityEvents         LearnerActivityEvent[]
  learningSessions       LearnerLearningSession[]
  learningTimeSlices     LearnerLearningTimeSlice[]
  materialProgress       LearnerMaterialProgress[]
  dailyLearningSummaries LearnerDailyLearningSummary[]
  profileSessions        RefreshToken[]
  aiTasks                AiTask[]
  audioTasks             AudioTask[]
  videoGuideLessons      VideoGuideLesson[]
  guidedStudyMaterials   EnglishGuidedStudyMaterial[]
  flashcardDecks         LearningFlashcardDeck[]
  flashcardReviews       LearningFlashcardReview[]
  copybookRecords        CopybookRecord[]
  typingLibraryProgress  TypingLibraryProgress[]
  typingSessions         TypingPracticeSession[]
  typingReviewStates     TypingReviewState[]
  typingPreference       TypingPreference?

  @@index([userId, status, createdAt])
  @@unique([userId, accountNumber])
  @@map("learners")
}

model LearnerScenarioAuthorization {
  learnerId    String
  scenarioId   String
  authorizedAt DateTime @default(now())
  learner      Learner @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  scenario     AiScenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict)

  @@id([learnerId, scenarioId])
  @@index([scenarioId])
  @@map("learner_scenario_authorizations")
}

model LearnerCourseAuthorization {
  learnerId    String
  courseId     String
  authorizedAt DateTime @default(now())
  learner      Learner @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  course       Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([learnerId, courseId])
  @@index([courseId])
  @@map("learner_course_authorizations")
}

model LearnerActivityEvent {
  id             String @id @default(cuid())
  userId         String
  learnerId      String
  eventType      LearnerActivityEventType
  scenarioId     String?
  courseId       String?
  courseRevisionId String?
  courseRevisionItemId String?
  resourceType   String?
  resourceId     String?
  materialType   CourseMaterialType?
  materialId     String?
  contentVersion String?
  partKey        String?
  itemKey        String?
  idempotencyKey String? @unique
  occurredAt     DateTime @default(now())
  metrics        Json?
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  learner        Learner @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  scenario       AiScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  course         Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([learnerId, occurredAt])
  @@index([userId, occurredAt])
  @@index([scenarioId, occurredAt])
  @@index([courseId, occurredAt])
  @@index([learnerId, materialType, materialId, occurredAt], map: "learner_activity_events_learnerId_materialType_materialId_occur")
  @@index([resourceType, resourceId])
  @@map("learner_activity_events")
}

model LearnerLearningSession {
  id               String    @id @default(cuid())
  userId           String
  learnerId        String
  profileSessionId String
  clientSessionKey String
  startedAt        DateTime  @default(now())
  lastHeartbeatAt  DateTime
  endedAt          DateTime?
  endReason        LearnerLearningSessionEndReason?
  lastSequence     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  learner          Learner   @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  profileSession   RefreshToken @relation(fields: [profileSessionId], references: [id], onDelete: Restrict)
  timeSlices       LearnerLearningTimeSlice[]

  @@unique([profileSessionId, clientSessionKey])
  @@index([learnerId, startedAt])
  @@index([lastHeartbeatAt, endedAt])
  @@map("learner_learning_sessions")
}

model LearnerLearningTimeSlice {
  id                   String   @id @default(cuid())
  userId               String
  learnerId            String
  sessionId            String
  bucketStartedAt      DateTime
  durationSeconds      Int
  isLearning           Boolean
  activitySignal       LearnerLearningSignal
  scenarioId           String?
  courseId             String?
  courseRevisionId     String?
  courseRevisionItemId String?
  resourceType         String?
  resourceId           String?
  materialType         CourseMaterialType?
  materialId           String?
  contentVersion       String?
  partKey              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  learner              Learner  @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  session              LearnerLearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([learnerId, bucketStartedAt])
  @@index([learnerId, bucketStartedAt])
  @@index([scenarioId, bucketStartedAt])
  @@index([courseId, bucketStartedAt])
  @@index([materialType, materialId, bucketStartedAt], map: "learner_learning_time_slices_materialType_materialId_bucketStar")
  @@map("learner_learning_time_slices")
}

model LearnerMaterialProgress {
  id                 String                @id @default(cuid())
  userId             String
  learnerId          String
  materialType       CourseMaterialType
  materialId         String
  contentVersion     String
  status             LearnerLearningStatus @default(NOT_STARTED)
  progressPercent    Int                   @default(0)
  activeStudySeconds Int                   @default(0)
  firstStartedAt     DateTime?
  lastStudiedAt      DateTime?
  completedAt        DateTime?
  studyCount         Int                   @default(0)
  completionCount    Int                   @default(0)
  lastPosition       Json?
  progressData       Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  learner            Learner               @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  parts              LearnerMaterialPartProgress[]

  @@unique([learnerId, materialType, materialId, contentVersion], map: "learner_material_progress_learnerId_materialType_materialId_con")
  @@index([userId, learnerId, lastStudiedAt])
  @@index([materialType, materialId])
  @@map("learner_material_progress")
}

model LearnerMaterialPartProgress {
  id                 String                @id @default(cuid())
  materialProgressId String
  partKey            String
  status             LearnerLearningStatus @default(NOT_STARTED)
  progressPercent    Int                   @default(0)
  activeStudySeconds Int                   @default(0)
  firstStartedAt     DateTime?
  lastStudiedAt      DateTime?
  completedAt        DateTime?
  progressData       Json?
  metrics            Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  materialProgress   LearnerMaterialProgress @relation(fields: [materialProgressId], references: [id], onDelete: Cascade)

  @@unique([materialProgressId, partKey])
  @@index([partKey, lastStudiedAt])
  @@map("learner_material_part_progress")
}

model LearnerDailyLearningSummary {
  id                      String                      @id @default(cuid())
  userId                  String
  learnerId               String
  summaryDate             DateTime                    @db.Date
  scopeType               LearnerLearningSummaryScope
  scopeKey                String
  scenarioId              String?
  courseId                String?
  resourceType            String?
  resourceId              String?
  materialType            CourseMaterialType?
  materialId              String?
  partKey                 String?
  onlineSeconds           Int                         @default(0)
  studySeconds            Int                         @default(0)
  meaningfulActionCount   Int                         @default(0)
  startedMaterialCount    Int                         @default(0)
