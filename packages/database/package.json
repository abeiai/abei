{
  "name": "@xueleai/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "pnpm db:studio",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test prisma/*.test.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "admin:reset-password": "tsx src/reset-admin-password.ts",
    "admin:reset-password:prod": "node dist/reset-admin-password.js",
    "textbooks:import-smartedu": "tsx prisma/import-smartedu-textbooks.ts",
    "textbooks:upload-smartedu-pdfs": "tsx prisma/upload-smartedu-textbook-pdfs.ts",
    "textbooks:generate-pdf-covers": "tsx prisma/generate-textbook-pdf-covers.ts",
    "textbooks:backup-pdfs": "tsx prisma/backup-textbook-pdfs-to-local.ts",
    "textbooks:convert-markdown": "tsx prisma/convert-textbook-pdfs-to-markdown.ts",
    "textbooks:upload-markdown-r2": "tsx prisma/upload-textbook-markdown-to-r2.ts",
    "dict:import-ecdict": "tsx prisma/import-ecdict.ts",
    "typing:import-yl-7a": "tsx prisma/import-typing-wordlist.ts",
    "typing:import-yilin-primary": "tsx prisma/import-yilin-primary-wordlists.ts",
    "typing:import-yilin-secondary": "tsx prisma/import-yilin-secondary-wordlists.ts",
    "typing:import-yilin-senior": "tsx prisma/import-yilin-senior-wordlists.ts",
    "typing:import-hujiao": "tsx prisma/import-hujiao-wordlists.ts",
    "typing:import-pep": "tsx prisma/import-pep-wordlists.ts",
    "typing:import-cet": "tsx prisma/import-cet-wordlists.ts",
    "typing:sync-cet-dictionary": "tsx prisma/sync-cet-dictionary-snapshot.ts",
    "typing:sync-content-snapshot": "tsx prisma/sync-typing-content-snapshot.ts",
    "typing:migrate-images-r2": "tsx prisma/migrate-typing-images-to-r2.ts",
    "typing:sync-scenario": "tsx prisma/sync-typing-scenario.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "template:blank": "tsx prisma/template-blank.ts",
    "ai:seed-tools": "tsx prisma/ai-seed-tools.ts",
    "ai:seed-presets": "tsx prisma/ai-seed-presets.ts",
    "ai:configure-abeiai": "tsx prisma/configure-abeiai.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "dotenv": "17.4.2",
    "pg": "^8.20.0",
    "prisma": "7.8.0",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@xueleai/config": "workspace:*",
    "@types/node": "25.6.2",
    "@types/pg": "^8.20.0",
    "eslint": "10.3.0",
    "typescript": "6.0.3"
  }
}
